{
  "name": "@aiszlab/relax",
  "version": "3.0.0",
  "description": "react utils collection",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.cjs",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "node": "./dist/*/index.cjs",
      "require": "./dist/*/index.cjs",
      "import": "./dist/*/index.mjs",
      "default": "./dist/*/index.mjs"
    },
    "./types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "clean:build": "jrv rm dist",
    "prepublishOnly": "pnpm run clean:build && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "react-is": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@aiszlab/jarvis": "catalog:",
    "@babel/core": "catalog:",
    "@babel/plugin-transform-runtime": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-is": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "react",
    "hooks"
  ],
  "author": "tutu@fantufantu.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://aisz.dev/hooks"
}
