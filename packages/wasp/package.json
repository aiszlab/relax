{
  "name": "@aiszlab/wasp",
  "version": "2.1.3",
  "type": "module",
  "bin": {
    "wasp": "bin/index.js"
  },
  "exports": {
    "./env": "./types/env.d.ts",
    "./vite": {
      "types": "./bin/vite.d.ts",
      "default": "./bin/vite.js"
    },
    "./tailwindcss": {
      "style": "./plugins/tailwind.css",
      "types": "./bin/tailwindcss.d.ts",
      "default": "./bin/tailwindcss.js"
    }
  },
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "description": "shell for any build scripts",
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "commander": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@aiszlab/jarvis": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "bin/",
    "types/",
    "plugins/"
  ],
  "author": "tutu@fantufantu.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
