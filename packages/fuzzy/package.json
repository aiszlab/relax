{
  "name": "@aiszlab/fuzzy",
  "version": "3.0.1",
  "description": "more more more apis(useless)",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "node": "./dist/*/index.cjs",
      "require": "./dist/*/index.cjs",
      "import": "./dist/*/index.mjs",
      "default": "./dist/*/index.mjs"
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "clean:build": "jrv rm dist",
    "prepublishOnly": "npm run clean:build && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aiszlab/relax": "workspace:^",
    "@babel/runtime": "catalog:"
  },
  "devDependencies": {
    "@aiszlab/jarvis": "catalog:",
    "@babel/plugin-transform-runtime": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "rollup": "catalog:",
    "vitest": "catalog:"
  },
  "author": "tutu@fantufantu.com",
  "license": "MIT",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
