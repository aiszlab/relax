{
  "name": "@aiszlab/bee",
  "version": "3.0.1",
  "description": "aiszlab csr app",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.cjs",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "node": "./dist/router.cjs",
      "require": "./dist/router.cjs",
      "import": "./dist/router.mjs",
      "default": "./dist/router.mjs"
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "prepublishOnly": "jrv rm dist && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "tutu@fantufantu.com",
  "license": "MIT",
  "dependencies": {
    "@aiszlab/relax": "workspace:^",
    "@babel/runtime": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@aiszlab/jarvis": "catalog:",
    "@babel/plugin-transform-runtime": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
